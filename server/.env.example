# Copie este arquivo para ".env" e ajuste os valores antes de rodar em producao
PORT=3000
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
DB_PATH=./data/ffa.sqlite

# Usuario administrador criado automaticamente no primeiro start (apenas se o banco estiver vazio)
ADMIN_NAME=Filipe Ferreira
ADMIN_EMAIL=dr.filipeferreirasantana@gmail.com
ADMIN_PASSWORD=troque-esta-senha-no-primeiro-acesso

# ---- Integracao DJEN / Comunica API (ver server/src/integrations/djen.js) ----
# API PUBLICA do CNJ para consulta de intimacoes/publicacoes - NAO exige certificado digital.
# Preencha com o numero e UF da OAB do advogado (ou do escritorio) para ativar a
# sincronizacao automatica de notificacoes de todos os tribunais do pais.
ADVOGADO_OAB_NUMERO=37159
ADVOGADO_OAB_UF=ES
DJEN_SYNC_INTERVAL_HOURS=6
# DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# ---- Google Agenda (ver server/src/integrations/googleCalendar.js) ----
# Credenciais OAuth criadas no Google Cloud Console (Calendar API habilitada).
# GOOGLE_REDIRECT_URI deve ser <URL publica do seu sistema>/api/integrations/google/callback
# Passo a passo completo no README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# ---- Integracao PJe via MNI/SOAP (opcional, ver server/src/integrations/pje.js) ----
# Usada apenas se, alem das intimacoes do DJEN, voce quiser consultar detalhes
# adicionais direto no PJe de um tribunal especifico. Exige certificado A1 (.pfx).
# Certificado A3 (token/cartao) NAO funciona aqui: nao ha leitora de hardware conectada ao servidor.
PJE_CERT_PFX_PATH=
PJE_CERT_PASSWORD=
PJE_MNI_ENDPOINT=
